{
  "name": "volto-subsites",
  "version": "4.0.2",
  "description": "Volto addon to manage subsites",
  "main": "src/index.js",
  "repository": "https://github.com/collective/volto-subsites.git",
  "author": "RedTurtle",
  "license": "MIT",
  "scripts": {
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "release": "release-it",
    "test": "vitest --config ./vitest.config.mjs run --passWithNoTests",
    "test:fix": "vitest --config ./vitest.config.mjs run --passWithNoTests --update",
    "dry-release": "release-it --dry-run",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha",
    "prepare": "cd ../.. && husky install || true"
  },
  "dependencies": {},
  "devDependencies": {
    "@plone/scripts": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "23.0.0",
    "release-it": "^14.10.1",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "@cypress/code-coverage": "^3.10.0",
    "@plone/registry": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "cypress": "13.1.0",
    "dotenv": "^16.3.2",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "redux-mock-store": "1.5.4",
    "redux-thunk": "^2.4.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@plone/volto": ">=16.0.0-alpha.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
